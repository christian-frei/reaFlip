desc:ReaFlip
// The name lives here, in NAME in ReaFlip_Load.lua and in the README.
// Behaviour: doc/ears.md, build notes: AGENTS.md.
options:gmem=ReaFlip
options:maxmem=2097152

// Hidden: the load action writes a random token here so that only this
// instance answers its gmem request (gmem is shared by all instances).
slider1:0<0,1000000,1>-load token
slider2:0<0,1,1{Hold,Trigger}>Cue play mode
slider3:0<0,1,1{Mono,Poly}>Voice mode
slider4:1<0,1,1{Off,On}>Velocity
slider5:1<0,1,1{Off,On}>Lazy chop

in_pin:none
out_pin:Left
out_pin:Right

@init
// @init also runs on every playback start unless this is set, and must
// never reset a loaded sample
ext_noinit = 1;

// gmem layout shared with ReaFlip_Load.lua
G_REQ = 0; G_TOKEN = 1; G_START = 2; G_LEN = 3; G_PATHLEN = 4; G_PATH = 16;

// memory regions
BUDGET = 1587600;                 // 18 s x 44.1 kHz x 2 ch in sample values (C5, R1.13)
BUF = 0;
SCRATCH = 1600000;                // discard area while reading up to the section start
CHUNK = 65536;                    // values per block; verified dropout-free in the probe
PEAKS = 1700000; NPEAKS = 2048;   // coarse waveform peaks, computed once per load
PEAKS2 = 1740000; NPEAKS2 = 16384; // finer peaks, so zoomed views stay cheap to draw
EV = 1710000; EV_MAX = 1000;      // this block's pad events: offset, pad, velocity (0 = release)
NPADS = 16;
// cues, one entry per pad; positions in seconds of the loaded section
CU_SET = 1720000; CU_START = CU_SET + 16; CU_END = CU_SET + 32;   // CU_END < 0 = no end set
CU_LEVEL = CU_SET + 48; CU_ATT = CU_SET + 64; CU_REL = CU_SET + 80; // dB, seconds, seconds
CU_FILT = CU_SET + 96;            // -1 low-pass .. 0 off .. +1 high-pass (R17.4-R17.6)
CU_REV = CU_SET + 112; CU_KEY = CU_SET + 128;   // 0/1; semitones -24..24
CU_LOOP = CU_SET + 144; CU_XF = CU_SET + 160;   // 0 off, 1 forward, 2 backward, 3 alternate; seconds
// voices: 0..15 belong to pads, 16..31 are tails that fade out a cut voice,
// 32 plays the source itself (play/pause and lazy chop)
NV = 33; SRC = 32;
// One field per 40 values, so copy_voice can walk them. Positions are in
// source frames; a voice plays between LO and HI in direction DIR.
V_ST = 1730000; NVF = 31;
V_POS = V_ST + 40; V_HI = V_ST + 80; V_ENV = V_ST + 120;
V_GAIN = V_ST + 160; V_ATT = V_ST + 200; V_REL = V_ST + 240; V_HELD = V_ST + 280;
V_RELSET = V_ST + 320;            // cue release in seconds, used by Trigger mode (R15.9)
V_LO = V_ST + 360; V_DIR = V_ST + 400; V_PDIR = V_ST + 440;  // current and playing direction
V_SPD = V_ST + 480;               // key shift as a speed ratio (R17.8)
V_XG = V_ST + 520; V_XGI = V_ST + 560;   // loop crossfade fade-in gain and its increment
V_FON = V_ST + 600; V_FV = V_ST + 640;   // filter on; the cue value it was built from
V_B0 = V_ST + 680; V_B1 = V_ST + 720; V_B2 = V_ST + 760; V_A1 = V_ST + 800; V_A2 = V_ST + 840;
V_X1L = V_ST + 880; V_X2L = V_ST + 920; V_Y1L = V_ST + 960; V_Y2L = V_ST + 1000;
V_X1R = V_ST + 1040; V_X2R = V_ST + 1080; V_Y1R = V_ST + 1120; V_Y2R = V_ST + 1160;
VS_OFF = 0; VS_ATT = 1; VS_SUS = 2; VS_REL = 3; VS_PARK = 4;
RAMP_S = 0.002;                   // click-free start/stop (R15.12)

// MIDI map. Learn steps double as control ids; step 0 is the 16 pads.
// SHIFT + x steps exist because a controller may send other messages while
// its Shift is held.
L_PADS = 0; L_DIAL = 1; L_SHIFT = 2; L_SDIAL = 3; L_DELETE = 4; L_LEFT = 5; L_RIGHT = 6;
L_DIALPRESS = 7; L_PLAY = 8; L_TRIG = 9; L_STRIPMODE = 10;
L_ENC1 = 11; L_ENC1P = 15;        // encoders 1-4 turn: 11..14, press: 15..18
L_UNDO = 19; L_REDO = 20; L_AUTOSET = 21; L_SAUTOSET = 22; L_FAV = 23; L_SFAV = 24;
L_SELALL = 25; L_SSELALL = 26; L_NOTEREP = 27;
L_STRIP = 28;                     // last: it sends a burst on the lightest touch
NSTEPS = 29;
K_NONE = 0; K_NOTE = 1; K_CC = 2; K_PB = 3;
K_SAME = 4;                       // SHIFT + x sends what x sends: our own Shift state decides
E_CENTER = 1; E_TWOS = 2; E_SIGNBIT = 3; E_ABS = 4;   // how a relative control encodes a turn
M_PAD = 1760000; M_KIND = 1760020; M_NUM = 1760050; M_ENC = 1760080;    // active map
LM_PAD = 1760110; LM_KIND = 1760130; LM_NUM = 1760160; LM_ENC = 1760190; // being learned
REL_LAST = 1760220; LV = 1760250; // last absolute value per control; learn turn samples
M_CHN = 1760280; LM_CHN = 1760310; // channel per control (1-16): controllers reuse note
                                   // and CC numbers on different channels
// confirmed map shared with new instances and, via the load action, with
// REAPER's saved settings (R20.14): version (written last), layout, pad
// channel, 16 pads, kind/num/enc/channel per step. A map with another layout
// is ignored, so a changed step list never applies stale assignments.
G_MAP = 8192; MAP_LAYOUT = 2; MAP_SIZE = 19 + NSTEPS * 4;

// Source states. EMPTY is 0 so a new instance starts empty without @init
// assigning state, which would wipe a loaded sample on a samplerate change.
S_EMPTY = 0; S_LOADING = 1; S_PEAKS = 2; S_READY = 3; S_MISSING = 4;

// one dark theme, colours defined once
C_BG = 0x18181b; C_PANEL = 0x232327; C_FRAME = 0x3a3a40; C_TEXT = 0xe8e8ea;
C_DIM = 0x8a8a92; C_WAVE = 0x5ac8fa; C_WAVE_DIM = 0x2f6f8f; C_ERR = 0xff6b6b; C_WARN = 0xffb347;
C_BTN = 0x34343a; C_BTN_HOT = 0x46464e; C_BTN_ON = 0x5a5a66; C_PAD_EMPTY = 0x2c2c31;
PALETTE = 1729000;                // one colour per pad (R7.3)
PALETTE[0] = 0xff5a5a; PALETTE[1] = 0xff8c42; PALETTE[2] = 0xffc23d; PALETTE[3] = 0xd4e157;
PALETTE[4] = 0x7ed957; PALETTE[5] = 0x3ddc97; PALETTE[6] = 0x2ec4b6; PALETTE[7] = 0x3fb6ff;
PALETTE[8] = 0x5a8dff; PALETTE[9] = 0x8c6bff; PALETTE[10] = 0xbf5af2; PALETTE[11] = 0xff5ac8;
PALETTE[12] = 0xff7a8a; PALETTE[13] = 0xc9a26b; PALETTE[14] = 0x9aa5b1; PALETTE[15] = 0xe6e6e6;

function close_file()
(
  h >= 0 ? file_close(h);
  h = -1;
);

function all_voices_off()
(
  memset(V_ST, VS_OFF, NV);
  memset(V_ENV, 0, NV);
  src_playing = 0;
  lazy_pass = 0;
  ph_voice = -1;
);

function reset_cues()
(
  // a fresh load starts without any cues (R1.3)
  all_voices_off();
  memset(CU_SET, 0, NPADS);
  memset(CU_END, -1, NPADS);
  memset(CU_LEVEL, 0, NPADS);
  memset(CU_ATT, 0, NPADS);
  memset(CU_REL, 0, NPADS);
  memset(CU_FILT, 0, NPADS); memset(CU_REV, 0, NPADS); memset(CU_KEY, 0, NPADS);
  memset(CU_LOOP, 0, NPADS); memset(CU_XF, 0, NPADS);
  selected = -1;
);

function show_error(text)
(
  strcpy(#err, text);
  has_err = 1;
);

function eject()
(
  close_file();
  state = S_EMPTY;
  has_source = 0;
  has_err = 0;
  strcpy(#path, "");
  reset_cues();                  // R3.2
);

// A swap keeps cues; pull any that fall outside the new, shorter source
// back inside it (R2.2, R2.3).
function clamp_cues() local(i, last)
(
  last = sec_len - sec_len / 100;  // leaves one step at full zoom (Terms: minimum cue length)
  i = 0;
  loop(NPADS,
    CU_SET[i] ? (
      CU_START[i] > last ? CU_START[i] = max(0, last);
      CU_END[i] > sec_len ? CU_END[i] = sec_len;
      CU_END[i] >= 0 && CU_END[i] <= CU_START[i] ? CU_END[i] = sec_len;
    );
    i += 1;
  );
);

// Validate the requested file fully before touching the buffer, so a failed
// load leaves the current source playable. On project reopen a file that
// cannot be opened is "missing": keep path, section and cues (R5.3, R5.4).
function request_load(reopen)
  local(vh, rnch, rfsr, ravail, rskip, rwant, fresh)
(
  vh = file_open(#req_path);
  vh < 0 ? (
    reopen ? (
      close_file();
      all_voices_off();
      strcpy(#path, #req_path);
      sec_start = req_start; sec_len = req_len;
      has_source = 1;
      has_err = 0;
      state = S_MISSING;
    ) : show_error("The file could not be opened.");
  ) : (
    rnch = 0; rfsr = 0;
    file_riff(vh, rnch, rfsr);
    ravail = file_avail(vh);
    rskip = floor(req_start * rfsr + 0.5) * rnch;
    rwant = floor(req_len * rfsr + 0.5) * rnch;
    ravail >= 0 && rskip + rwant > ravail ? rwant = max(0, ravail - rskip);

    rnch < 1 || rfsr < 1 ? (
      file_close(vh);
      show_error("The file is not readable as WAV or AIFF audio.");                 // R1.9
    ) : rnch > 2 ? (
      file_close(vh);
      show_error("The file has more than two channels.");                           // R1.15
    ) : rwant < rnch ? (
      file_close(vh);
      show_error("The selected section contains no audio.");
    ) : rwant > BUDGET ? (
      file_close(vh);
      show_error(sprintf(#tmp, "The section is %.1f s long; the maximum for this file is %.1f s.",
        req_len, BUDGET / (rfsr * rnch)));                                          // R1.8
    ) : (
      close_file();
      all_voices_off();
      h = vh;
      // a load into an instance that has a source is a swap and keeps cues
      // (R2.1); so is a reopen, whose cues @serialize has just restored (R5.2)
      fresh = !has_source && !reopen;
      fresh ? reset_cues();
      has_source = 1;
      has_err = 0;
      strcpy(#path, #req_path);
      nch = rnch; fsr = rfsr;
      sec_start = req_start;
      sec_len = rwant / rnch / rfsr;
      !fresh && !reopen ? clamp_cues();
      ph = 0;
      view_reset = 1;
      skip_total = rskip; skipped = 0;
      want = rwant; got = 0;
      state = S_LOADING;
    );
  );
);

function begin_peaks()
(
  frames = floor(got / nch);
  memset(PEAKS, 0, NPEAKS);
  memset(PEAKS2, 0, NPEAKS2);
  pk_frame = 0;
  state = S_PEAKS;
);

// One chunk per block: file_* has no seek, so the section start is reached
// by reading past it into SCRATCH.
function load_step()
  local(n, r, i, b, v)
(
  state == S_LOADING ? (
    skipped < skip_total ? (
      n = min(CHUNK, skip_total - skipped);
      r = file_mem(h, SCRATCH, n);
      skipped += r;
      r < n ? (
        close_file();
        state = S_MISSING;
        show_error("Reading the file stopped early.");
      );
    ) : (
      n = min(CHUNK, want - got);
      r = file_mem(h, BUF + got, n);
      got += r;
      r < n || got >= want ? (
        close_file();
        begin_peaks();
      );
    );
  ) : state == S_PEAKS ? (
    i = pk_frame;
    loop(min(CHUNK, frames - pk_frame),
      v = abs(BUF[i * nch]);
      nch > 1 ? v = max(v, abs(BUF[i * nch + 1]));
      b = floor(i * NPEAKS / frames);  PEAKS[b] = max(PEAKS[b], v);
      b = floor(i * NPEAKS2 / frames); PEAKS2[b] = max(PEAKS2[b], v);
      i += 1;
    );
    pk_frame = i;
    pk_frame >= frames ? state = S_READY;
  );
);

function progress()
(
  state == S_LOADING ? 0.9 * (skipped + got) / max(1, skip_total + want)
  : state == S_PEAKS ? 0.9 + 0.1 * pk_frame / max(1, frames)
  : 1;
);

// ---- cues and playback ----

// A cue without an end plays to the next cue's start, or to the section
// end when no cue follows (R10.14).
function cue_end(p) local(e, i)
(
  CU_END[p] >= 0 ? CU_END[p] : (
    e = sec_len;
    i = 0;
    loop(NPADS,
      CU_SET[i] && CU_START[i] > CU_START[p] && CU_START[i] < e ? e = CU_START[i];
      i += 1;
    );
    e;
  );
);

function new_cue(p, t)
(
  // R9.11: default parameters, no end point
  CU_SET[p] = 1; CU_START[p] = t; CU_END[p] = -1;
  CU_LEVEL[p] = 0; CU_ATT[p] = 0; CU_REL[p] = 0;
  CU_FILT[p] = 0; CU_REV[p] = 0; CU_KEY[p] = 0; CU_LOOP[p] = 0; CU_XF[p] = 0;   // R17.19, R17.24
);

function all_pads_set() local(i, n)
(
  n = 0; i = 0;
  loop(NPADS, n += CU_SET[i]; i += 1);
  n == NPADS;
);

function copy_voice(src, dst) local(k)
(
  k = 0; loop(NVF, V_ST[dst + k * 40] = V_ST[src + k * 40]; k += 1);
);

// Fade a voice out over n samples in a tail slot, carrying on in its current
// direction past its bounds, with its filter state, so nothing clicks.
function to_tail(v, n) local(t)
(
  t = NPADS + tail_next;
  tail_next = (tail_next + 1) % NPADS;
  copy_voice(v, t);
  V_LO[t] = 0; V_HI[t] = frames - 1; V_HELD[t] = 0;
  V_REL[t] = V_ENV[v] / max(n, 1);
  V_ST[t] = VS_REL;
);

// Hand a sounding voice over to a tail slot that fades it out, so a
// retrigger, seek or Mono steal never clicks (R15.11, R15.12, R16.2).
function cut(v)
(
  V_ST[v] != VS_OFF && V_ST[v] != VS_PARK && V_ENV[v] > 0 ? to_tail(v, ramp_n);
  V_ST[v] = VS_OFF;
  V_ENV[v] = 0;
);

// cutoff for a filter setting: 17 kHz at the centre, 80 Hz at either end,
// on a log scale (R17.4, R17.5)
function filter_fc(f) ( f < 0 ? 17000 * (80 / 17000) ^ -f : 80 * (17000 / 80) ^ f; );

// RBJ biquad, Q 0.707; a voice starting or coming back from off starts clean
function set_filter(v, f) local(w, c, al, a0)
(
  V_FV[v] = f;
  f == 0 ? V_FON[v] = 0 : (
    w = 2 * $pi * min(filter_fc(f), srate * 0.45) / srate;
    c = cos(w); al = sin(w) / (2 * 0.7071); a0 = 1 + al;
    f < 0 ? ( V_B0[v] = (1 - c) / 2 / a0; V_B1[v] = (1 - c) / a0; )
          : ( V_B0[v] = (1 + c) / 2 / a0; V_B1[v] = -(1 + c) / a0; );
    V_B2[v] = V_B0[v]; V_A1[v] = -2 * c / a0; V_A2[v] = (1 - al) / a0;
    !V_FON[v] ? (
      V_X1L[v] = V_X2L[v] = V_Y1L[v] = V_Y2L[v] = 0;
      V_X1R[v] = V_X2R[v] = V_Y1R[v] = V_Y2R[v] = 0;
    );
    V_FON[v] = 1;
  );
);

// A looping cue reached the end of a pass (R17.20-R17.23): the old
// direction fades out in a tail while the next pass fades in, over the
// loop crossfade (at least the click-free ramp, R15.12).
function loop_seam(v) local(n, d, m)
(
  d = V_DIR[v]; m = CU_LOOP[v];
  n = max(min(CU_XF[v], (V_HI[v] - V_LO[v]) / fsr) * srate, ramp_n);
  to_tail(v, n);
  m == 3 || (m == 2 && d == V_PDIR[v]) ? (
    // alternate turns at every seam; backward turns once, after the first pass
    V_POS[v] = d > 0 ? V_HI[v] - 1 : V_LO[v];
    V_DIR[v] = -d;
  ) : V_POS[v] = d > 0 ? V_LO[v] : V_HI[v] - 1;   // start the pass again
  V_XG[v] = 0; V_XGI[v] = 1 / n;
);

// the source player: plays from a position to the section end (R6.1)
function src_start(pos)
(
  cut(SRC);
  V_POS[SRC] = max(0, min(pos, frames - 1));
  V_LO[SRC] = 0; V_HI[SRC] = frames;
  V_DIR[SRC] = V_PDIR[SRC] = 1; V_SPD[SRC] = 1; V_XG[SRC] = 1; V_FON[SRC] = 0;
  V_ENV[SRC] = 0; V_ATT[SRC] = 1 / ramp_n; V_RELSET[SRC] = 0;
  V_GAIN[SRC] = 1; V_HELD[SRC] = 0;
  V_ST[SRC] = VS_ATT;
  src_playing = 1;
  ph_voice = -1;
  ph = V_POS[SRC];
);

function src_stop()
(
  ph = V_POS[SRC];               // R6.2: the playhead stays where it stopped
  V_ST[SRC] == VS_ATT || V_ST[SRC] == VS_SUS ? (
    V_REL[SRC] = V_ENV[SRC] / ramp_n;
    V_ST[SRC] = VS_REL;
  );
  src_playing = 0;
  lazy_pass = 0;                 // R9.8
);

function seek(pos)
(
  src_playing ? src_start(pos) : ( ph = max(0, min(pos, frames - 1)); ph_voice = -1; );
);

function play_cue(p, vel) local(i)
(
  src_playing ? src_stop();      // one playhead: the cue takes it over
  slider3 == 0 ? (               // R16.2: Mono stops every other cue
    i = 0;
    loop(NPADS, i != p ? cut(i); i += 1);
  );
  cut(p);                        // R15.11: restart from the start
  V_LO[p] = CU_START[p] * fsr;
  V_HI[p] = cue_end(p) * fsr;
  // R17.7, R17.26: a reversed cue plays from its end towards its start
  V_DIR[p] = V_PDIR[p] = CU_REV[p] ? -1 : 1;
  V_POS[p] = CU_REV[p] ? V_HI[p] - 1 : V_LO[p];
  V_SPD[p] = 2 ^ (CU_KEY[p] / 12);                        // R17.8
  V_XG[p] = 1; V_XGI[p] = 0;
  V_FON[p] = 0; set_filter(p, CU_FILT[p]);
  V_ENV[p] = 0;
  V_ATT[p] = 1 / max(CU_ATT[p] * srate, ramp_n);
  V_RELSET[p] = CU_REL[p];
  V_REL[p] = 1 / max(CU_REL[p] * srate, ramp_n);
  // R17.11, R17.12: 127 plays at the set level, lower is proportionally quieter
  V_GAIN[p] = 10 ^ (CU_LEVEL[p] / 20) * (slider4 ? vel / 127 : 1);
  V_HELD[p] = 1;
  V_ST[p] = VS_ATT;
  ph_voice = p;
);

function pad_press(p, vel)
(
  state == S_READY ? (                                    // R9.12, R15.14
    !CU_SET[p] ? (
      new_cue(p, ph / fsr);                               // R9.2, R9.4, R9.10
      selected = p;
      slider5 ? (
        // lazy chop: an empty pad starts a pass; while it runs the source
        // keeps playing and every empty pad drops a cue (R9.3, R9.5)
        !src_playing ? src_start(ph);
        lazy_pass = 1;
        all_pads_set() ? lazy_pass = 0;                   // R9.9
      );
    ) : lazy_pass ? (
      seek(CU_START[p] * fsr);                            // R9.7
      selected = p;
    ) : slider2 == 1 && CU_LOOP[p] && (V_ST[p] == VS_ATT || V_ST[p] == VS_SUS) ? (
      // R15.18: in Trigger mode a second press ends a looping cue
      V_REL[p] = V_ENV[p] / max(CU_REL[p] * srate, ramp_n);
      V_ST[p] = VS_REL;
      selected = p;
    ) : (
      play_cue(p, vel);
      selected = p;                                       // R15.3
    );
  );
);

function pad_release(p)
(
  V_HELD[p] = 0;
  slider2 == 0 ? (                                        // Hold mode only (R15.5, R15.8)
    V_ST[p] == VS_ATT || V_ST[p] == VS_SUS ? (
      V_REL[p] = V_ENV[p] / max(CU_REL[p] * srate, ramp_n);
      V_ST[p] = VS_REL;
    ) : V_ST[p] == VS_PARK ? V_ST[p] = VS_OFF;
  );
);

function delete_cue(p)
(
  CU_SET[p] ? (                                           // R11.7: empty pad, nothing changes
    cut(p);
    ph_voice == p ? ph_voice = -1;
    CU_SET[p] = 0; CU_END[p] = -1;                        // R11.1
    selected == p ? selected = -1;
  );
);

function add_event(offset, p, vel)
(
  ev_n < EV_MAX ? (
    EV[ev_n * 3] = offset; EV[ev_n * 3 + 1] = p; EV[ev_n * 3 + 2] = vel;
    ev_n += 1;
  );
);

// ---- MIDI map, learn and SLAB controls ----

function map_defaults() local(i)
(
  M_CH = 0;
  i = 0; loop(NPADS, M_PAD[i] = i; i += 1);              // R20.1
  memset(M_KIND, K_NONE, NSTEPS);
);

function gmem_has_map() ( gmem[G_MAP] > 0 && gmem[G_MAP + 1] == MAP_LAYOUT; );

function map_from_gmem() local(i)
(
  M_CH = gmem[G_MAP + 2];
  i = 0; loop(NPADS, M_PAD[i] = gmem[G_MAP + 3 + i]; i += 1);
  i = 0; loop(NSTEPS,
    M_KIND[i] = gmem[G_MAP + 19 + i * 4]; M_NUM[i] = gmem[G_MAP + 20 + i * 4];
    M_ENC[i] = gmem[G_MAP + 21 + i * 4]; M_CHN[i] = gmem[G_MAP + 22 + i * 4];
    i += 1;
  );
);

function map_to_gmem() local(i)
(
  gmem[G_MAP + 1] = MAP_LAYOUT;
  gmem[G_MAP + 2] = M_CH;
  i = 0; loop(NPADS, gmem[G_MAP + 3 + i] = M_PAD[i]; i += 1);
  i = 0; loop(NSTEPS,
    gmem[G_MAP + 19 + i * 4] = M_KIND[i]; gmem[G_MAP + 20 + i * 4] = M_NUM[i];
    gmem[G_MAP + 21 + i * 4] = M_ENC[i]; gmem[G_MAP + 22 + i * 4] = M_CHN[i];
    i += 1;
  );
  gmem[G_MAP] += 1;              // written last: readers only trust a non-zero version
);

function step_kind(k)            // 0 pads, 1 turn (relative), 2 button, 3 strip
(
  k == L_PADS ? 0 : k == L_DIAL || k == L_SDIAL || (k >= L_ENC1 && k < L_ENC1 + 4) ? 1 : k == L_STRIP ? 3 : 2;
);

// the control a SHIFT + x step builds on, or -1
function shift_base(k)
(
  k == L_SDIAL ? L_DIAL : k == L_SAUTOSET ? L_AUTOSET : k == L_SFAV ? L_FAV : k == L_SSELALL ? L_SELALL : -1;
);

function learn_name(k)
(
  k == L_DIAL ? "dial" : k == L_SHIFT ? "SHIFT" : k == L_SDIAL ? "SHIFT + dial" : k == L_DELETE ? "DELETE"
  : k == L_LEFT ? "left arrow" : k == L_RIGHT ? "right arrow" : k == L_DIALPRESS ? "dial press"
  : k == L_PLAY ? "PLAY" : k == L_TRIG ? "TRIGGER MODE" : k == L_STRIPMODE ? "STRIP MODE"
  : k == L_STRIP ? "touch strip" : k == L_ENC1 ? "encoder 1" : k == L_ENC1 + 1 ? "encoder 2"
  : k == L_ENC1 + 2 ? "encoder 3" : k == L_ENC1 + 3 ? "encoder 4" : k == L_ENC1P ? "encoder 1 press"
  : k == L_ENC1P + 1 ? "encoder 2 press" : k == L_ENC1P + 2 ? "encoder 3 press" : k == L_ENC1P + 3 ? "encoder 4 press"
  : k == L_UNDO ? "UNDO" : k == L_REDO ? "REDO" : k == L_AUTOSET ? "AUTO SET" : k == L_SAUTOSET ? "SHIFT + AUTO SET"
  : k == L_FAV ? "FAVORITE" : k == L_SFAV ? "SHIFT + FAVORITE" : k == L_SELALL ? "SELECT ALL"
  : k == L_SSELALL ? "SHIFT + SELECT ALL" : k == L_NOTEREP ? "NOTE REPEAT" : "pads";
);

function learn_error(text) ( strcpy(#learn_err, text); has_learn_err = 1; );

function learn_start()
(
  learn_active = 1; learn_done = 0;
  learn_step = 0; learn_count = 0; learn_phase = 0; g_on = 0;
  memset(LM_PAD, -1, NPADS);
  memset(LM_KIND, K_NONE, NSTEPS);
  LM_CH = -1;
  has_learn_err = 0;
);

function learn_next()
(
  learn_step += 1; learn_count = 0; learn_phase = 0; g_on = 0; has_learn_err = 0;
  learn_step >= NSTEPS ? learn_done = 1;
);

function lm_is(i, kind, num, ch)
(
  LM_KIND[i] == kind && LM_CHN[i] == ch && (kind == K_PB || LM_NUM[i] == num);
);

// a control may only do one job (R20.3 for pads, same rule for the rest)
function learn_used(kind, num, ch) local(i, used)
(
  used = 0;
  kind == K_NOTE && (LM_CH == 0 || LM_CH == ch) ? ( i = 0; loop(NPADS, LM_PAD[i] == num ? used = 1; i += 1); );
  i = 1; loop(NSTEPS - 1, lm_is(i, kind, num, ch) ? used = 1; i += 1);
  used;
);

// Dropped without complaint: turn controls and the strip fire on the
// lightest touch, and SHIFT is held on purpose during SHIFT + x steps.
function learn_quiet(kind, num, ch) local(i, q, b)
(
  b = shift_base(learn_step);
  q = b >= 0 && lm_is(L_SHIFT, kind, num, ch);
  i = 1;
  loop(NSTEPS - 1,
    i != b && (step_kind(i) == 1 || step_kind(i) == 3) && lm_is(i, kind, num, ch) ? q = 1;
    i += 1;
  );
  q;
);

// a SHIFT + x step that receives exactly what x sends needs no own control
function learn_same(kind, num, ch) local(b)
(
  b = shift_base(learn_step);
  b >= 0 && lm_is(b, kind, num, ch) ? ( LM_KIND[learn_step] = K_SAME; learn_next(); 1; ) : 0;
);

// Six values clockwise, then six counter-clockwise, tell the encoding
// (R20.13); an unclear pattern asks for another turn (R20.6).
function learn_infer() local(i, cw_hi, cw_lo, ccw_hi, ccw_lo, ccw_sum, mono, mode)
(
  cw_hi = cw_lo = ccw_hi = ccw_lo = 1; ccw_sum = 0;
  i = 0;
  loop(6,
    LV[i] > 64 ? cw_lo = 0 : LV[i] < 64 && LV[i] > 0 ? cw_hi = 0 : ( cw_hi = 0; cw_lo = 0; );
    LV[6 + i] > 64 ? ccw_lo = 0 : LV[6 + i] < 64 && LV[6 + i] > 0 ? ccw_hi = 0 : ( ccw_hi = 0; ccw_lo = 0; );
    ccw_sum += LV[6 + i];
    i += 1;
  );
  mono = 1;
  i = 1; loop(5, LV[i] < LV[i - 1] || LV[6 + i] > LV[5 + i] ? mono = 0; i += 1);
  mode = mono && LV[5] - LV[0] >= 3 && LV[6] - LV[11] >= 3 ? E_ABS
    : cw_hi && ccw_lo ? E_CENTER
    : cw_lo && ccw_hi ? ( ccw_sum / 6 > 96 ? E_TWOS : E_SIGNBIT )
    : 0;
  mode ? (
    LM_KIND[learn_step] = K_CC; LM_ENC[learn_step] = mode;
    learn_next();
  ) : (
    learn_error("Couldn't recognise that turn. Turn again: slowly clockwise first, then counter-clockwise.");
    learn_count = 0; learn_phase = 0;
  );
);

function learn_take(kind, num, ch)
(
  !learn_same(kind, num, ch) ? (
    learn_used(kind, num, ch) ? learn_error("That control already has another job. Press the one asked for.") : (
      LM_KIND[learn_step] = kind; LM_NUM[learn_step] = num; LM_CHN[learn_step] = ch;
      learn_next();
    );
  );
);

function learn_midi(m1, m2, m3) local(st, ch, k, i, used, kind, press)
(
  st = m1 & 0xF0; ch = (m1 & 15) + 1;
  k = step_kind(learn_step);
  kind = st == 0x90 || st == 0x80 ? K_NOTE : st == 0xB0 ? K_CC : st == 0xE0 ? K_PB : K_NONE;
  !learn_done && kind != K_NONE && !learn_quiet(kind, m2, ch) ? (
    k == 0 ? (
      st == 0x90 && m3 > 0 ? (                            // R20.2, R20.3
        used = 0; i = 0;
        loop(learn_count, LM_PAD[i] == m2 ? used = i + 1; i += 1);
        used ? learn_error(sprintf(#learn_tmp, "That pad is already pad %d. Hit pad %d.", used, learn_count + 1)) : (
          LM_PAD[learn_count] = m2;
          learn_count == 0 ? LM_CH = ch : LM_CH != ch ? LM_CH = 0;   // mixed channels: accept any
          learn_count += 1; has_learn_err = 0;
          learn_count >= NPADS ? learn_next();
        );
      );
    ) : k == 1 ? (
      kind == K_CC ? (                                    // R20.4
        learn_count == 0 && learn_phase == 0 ? (
          !learn_same(kind, m2, ch) ? (
            learn_used(K_CC, m2, ch) ? learn_error("That control already has another job. Turn the one asked for.")
            : ( LM_NUM[learn_step] = m2; LM_CHN[learn_step] = ch; LV[0] = m3; learn_count = 1; has_learn_err = 0; );
          );
        ) : m2 == LM_NUM[learn_step] && ch == LM_CHN[learn_step] ? (
          LV[learn_phase * 6 + learn_count] = m3;
          learn_count += 1;
          learn_count >= 6 ? ( learn_phase == 0 ? ( learn_phase = 1; learn_count = 0; ) : learn_infer(); );
        );
      );
    ) : k == 2 ? (
      // R20.7. Taken on release: touch-sensitive encoders send a touch note
      // first, then the press, so the last other control pressed while the
      // first is held wins. Releasing either one ends the gesture, so a
      // stray message without a release can't block the step.
      kind != K_PB ? (
        press = m3 > 0 && st != 0x80;
        press ? (
          !g_on ? ( g_on = 1; g_kind = kind; g_num = m2; g_ch = ch; c_kind = kind; c_num = m2; c_ch = ch; )
          : kind != g_kind || m2 != g_num || ch != g_ch ? ( c_kind = kind; c_num = m2; c_ch = ch; );
        ) : g_on && ((kind == g_kind && m2 == g_num && ch == g_ch) || (kind == c_kind && m2 == c_num && ch == c_ch)) ? (
          g_on = 0;
          learn_take(c_kind, c_num, c_ch);
        );
      );
    ) : (
      kind == K_CC || kind == K_PB ? learn_take(kind, m2, ch);
    );
  );
);

function learn_confirm() local(i)
(
  M_CH = max(LM_CH, 0);
  i = 0; loop(NPADS, M_PAD[i] = LM_PAD[i]; i += 1);
  i = 0; loop(NSTEPS, M_KIND[i] = LM_KIND[i]; M_NUM[i] = LM_NUM[i]; M_ENC[i] = LM_ENC[i]; M_CHN[i] = LM_CHN[i]; i += 1);
  memset(REL_LAST, -1, NSTEPS);
  map_to_gmem();                 // R20.9, R20.14
  learn_active = 0;
  strcpy(#slab_msg, "Learned controls saved.");
);

function say(text) ( strcpy(#slab_msg, text); );

function later(k) ( sprintf(#slab_msg, "%s: comes with slice 5.", learn_name(k)); );

function rel_delta(k, v) local(d)
(
  M_ENC[k] == E_CENTER ? v - 64
  : M_ENC[k] == E_TWOS ? ( v < 64 ? v : v - 128 )
  : M_ENC[k] == E_SIGNBIT ? ( v < 64 ? v : -(v - 64) )
  : (
    d = REL_LAST[k] < 0 ? 0 : v - REL_LAST[k];
    REL_LAST[k] = v;
    d;
  );
);

// R17.17: every parameter is held at its range limit; R17.27: the loop
// crossfade never exceeds the cue
function clamp_params(p)
(
  CU_LEVEL[p] = max(-12, min(12, CU_LEVEL[p]));
  CU_ATT[p] = max(0, min(10, CU_ATT[p]));
  CU_REL[p] = max(0, min(10, CU_REL[p]));
  CU_FILT[p] = max(-1, min(1, CU_FILT[p]));
  CU_KEY[p] = max(-24, min(24, floor(CU_KEY[p] + 0.5)));
  CU_XF[p] = max(0, min(cue_end(p) - CU_START[p], CU_XF[p]));
);

function reset_param(k, p)       // R17.9, R21.6: k as in the parameter row
(
  k == 0 ? CU_LEVEL[p] = 0 : k == 1 ? CU_ATT[p] = 0 : k == 2 ? CU_REL[p] = 0
  : k == 3 ? CU_FILT[p] = 0 : k == 4 ? CU_KEY[p] = 0 : k == 5 ? CU_REV[p] = 0
  : k == 6 ? CU_LOOP[p] = 0 : CU_XF[p] = 0;
);

// one step = 1/100 of the main waveform's span (Terms); the window keeps
// step_len current, a closed window falls back to the whole section
function edit_step() ( step_len > 0 ? step_len : sec_len / 100; );

// Cue edits shared by mouse and dial: R10.7-R10.9, first end at the
// implied end (R10.15), ends may pass the next cue (R10.16).
function set_start(p, t)
(
  t = min(t, (CU_END[p] >= 0 ? CU_END[p] : sec_len) - edit_step());
  CU_START[p] = max(0, t);
  clamp_params(p);
);

function set_end(p, t)
(
  CU_END[p] < 0 ? CU_END[p] = cue_end(p);
  CU_END[p] = max(min(sec_len, t), CU_START[p] + edit_step());
  clamp_params(p);
);

function nudge_time(t, d) local(sz)
(
  sz = t < 0.1 ? 0.002 : t < 1 ? 0.02 : 0.2;
  max(0, min(10, t + d * sz));   // R17.2, R17.3 range, held at the limits (R17.17)
);

function has_target() ( state == S_READY && selected >= 0 && CU_SET[selected]; );

function slab_control(k, val) local(d, i, pr, f)
(
  step_kind(k) == 1 ? (
    d = rel_delta(k, val);
    k == L_DIAL || k == L_SDIAL ? (
      has_target() ? (
        slab_shift || k == L_SDIAL ? set_end(selected, cue_end(selected) + d * edit_step())   // R10.4
                                   : set_start(selected, CU_START[selected] + d * edit_step()); // R10.3
      );
    ) : (
      i = k - L_ENC1;
      has_target() ? (
        i == 0 ? CU_LEVEL[selected] += d * 0.5                              // R21.2
        : i == 1 ? (                                                        // R21.3
          f = CU_FILT[selected] + d * 0.02;
          // crossing the centre stops at off, so it can be found by feel (R17.6)
          CU_FILT[selected] != 0 && (f < 0) != (CU_FILT[selected] < 0) ? f = 0;
          CU_FILT[selected] = f;
        )
        : i == 2 ? CU_ATT[selected] = nudge_time(CU_ATT[selected], d)       // R21.4
        : CU_KEY[selected] += d;                                            // R21.5
        clamp_params(selected);
      );
    );
  ) : k == L_STRIP ? (
    has_target() ? (
      strip_mode == 0 ? (
        CU_FILT[selected] = val / 127 * 2 - 1;                               // R21.17
        abs(CU_FILT[selected]) < 0.04 ? CU_FILT[selected] = 0;               // a centre you can hit (R17.6)
      ) : strip_mode == 1 ? CU_LEVEL[selected] = -12 + 24 * val / 127        // R21.18
      : CU_XF[selected] = (cue_end(selected) - CU_START[selected]) * val / 127;   // R21.26
      clamp_params(selected);
    );
  ) : (
    pr = val > 0;
    k == L_SHIFT ? slab_shift = pr
    : k == L_DELETE ? slab_delete = pr
    : pr ? (
      k == L_DIALPRESS || k == L_PLAY ? (                                    // R21.1, R21.15
        state == S_READY ? ( src_playing ? src_stop() : src_start(ph); );
      ) : k == L_TRIG ? (
        slider2 = !slider2; slider_automate(slider2);                        // R21.14
      ) : (k == L_FAV && slab_shift) || k == L_SFAV ? (
        slider3 = !slider3; slider_automate(slider3);                        // R21.12
      ) : k == L_STRIPMODE ? (
        strip_mode = (strip_mode + 1) % 3;                                   // R21.16
        say(strip_mode == 0 ? "Touch strip: filter" : strip_mode == 1 ? "Touch strip: pad level" : "Touch strip: loop crossfade");
      ) : k >= L_ENC1P && k < L_ENC1P + 4 ? (
        i = k - L_ENC1P;                                                     // R21.6
        has_target() ? reset_param(i == 0 ? 0 : i == 1 ? 3 : i == 2 ? 1 : 4, selected);
      ) : k == L_NOTEREP ? (
        has_target() ? CU_LOOP[selected] = (CU_LOOP[selected] + 1) % 4;      // R21.25
      ) : k == L_LEFT || k == L_RIGHT ? (
        say("Arrows need the beatgrid: comes with slice 5.");
      ) : later(k);
    );
  );
);

// Route one incoming message; returns 0 when nothing here uses it, so the
// caller passes it on (R20.12). Learned controls match their exact channel
// and go first, so a button sharing a pad's note on another channel is
// never a pad. Pads listen on the pads' channel only (R20.11).
function route_midi(offset, m1, m2, m3) local(st, ch, i, k, val, hit)
(
  st = m1 & 0xF0; ch = (m1 & 15) + 1;
  hit = 0;
  k = 1;
  loop(NSTEPS - 1,
    !hit && M_KIND[k] != K_NONE && (M_CHN[k] == 0 || M_CHN[k] == ch) ? (
      M_KIND[k] == K_NOTE && (st == 0x90 || st == 0x80) && m2 == M_NUM[k] ? ( hit = 1; slab_control(k, st == 0x90 ? m3 : 0); )
      : M_KIND[k] == K_CC && st == 0xB0 && m2 == M_NUM[k] ? ( hit = 1; slab_control(k, m3); )
      : M_KIND[k] == K_PB && st == 0xE0 ? ( hit = 1; slab_control(k, (m3 * 128 + m2) / 16383 * 127); );
    );
    k += 1;
  );
  !hit && (st == 0x90 || st == 0x80) && (M_CH == 0 || ch == M_CH) ? (
    i = 0;
    loop(NPADS,
      !hit && M_PAD[i] == m2 ? (
        hit = 1;
        val = st == 0x90 ? m3 : 0;                        // note-on with velocity 0 is a release
        slab_delete && val > 0 ? ( state == S_READY ? delete_cue(i); )   // R11.3
        : add_event(offset, i, val);
      );
      i += 1;
    );
  );
  hit;
);

// a new instance takes the last confirmed map, else the defaults (R20.14);
// a saved project's own map arrives later through @serialize
!map_init ? (
  gmem_has_map() ? map_from_gmem() : map_defaults();
  memset(REL_LAST, -1, NSTEPS);
  map_init = 1;
);

@block
gmem[G_REQ] != last_req ? (
  last_req = gmem[G_REQ];
  slider1 > 0 && gmem[G_TOKEN] == slider1 ? (
    // %c keeps the path's UTF-8 bytes intact
    strcpy(#req_path, "");
    i = 0;
    loop(gmem[G_PATHLEN], sprintf(#ch, "%c", gmem[G_PATH + i]); strcat(#req_path, #ch); i += 1);
    req_start = gmem[G_START];
    req_len = gmem[G_LEN];
    request_load(0);
  );
);
reload_pending ? (
  reload_pending = 0;
  request_load(1);
);
state == S_LOADING || state == S_PEAKS ? load_step();

ramp_n = max(1, floor(RAMP_S * srate));
step = fsr / srate;               // play at the file's own rate

// requests from the window, applied here so only the audio thread touches voices
state == S_READY ? (                                      // R6.7: ignored without a source
  play_req ? ( src_playing ? src_stop() : src_start(ph); );
  seek_req ? seek(seek_pos);
  del_req ? delete_cue(del_req - 1);
);
play_req = 0; seek_req = 0; del_req = 0;

// a filter moved while its cue sounds follows at once (R21.17)
i = 0;
loop(NPADS,
  V_ST[i] != VS_OFF && V_FV[i] != CU_FILT[i] ? set_filter(i, CU_FILT[i]);
  i += 1;
);

// Learn (R20): start, skip an optional step, cancel, confirm
learn_req == 1 ? (
  all_voices_off();              // their note-offs would go to Learn instead
  learn_start();
) : learn_req == 2 ? (
  learn_active && !learn_done && learn_step > L_DIAL ? learn_next();   // pads and dial are required
) : learn_req == 3 ? (
  learn_active = 0;              // R20.10: the old mapping was never touched
) : learn_req == 4 ? (
  learn_active && learn_done ? learn_confirm();
);
learn_req = 0;

// Pad events are queued with their sample offset and fired in @sample, so
// finger drumming keeps its timing inside the block. Mouse clicks go first.
ev_n = 0; ev_i = 0; smp = 0;
gfx_press ? ( add_event(0, gfx_press - 1, 127); gfx_press = 0; );
gfx_release ? ( add_event(0, gfx_release - 1, 0); gfx_release = 0; );
while (midirecv(offset, msg1, msg2, msg3) ? (
  // shown in the window: tells at a glance whether and what a controller sends
  mon_1 = msg1; mon_2 = msg2; mon_3 = msg3; mon_count += 1;
  learn_active ? learn_midi(msg1, msg2, msg3)            // Learn takes everything
  : !route_midi(offset, msg1, msg2, msg3) ? midisend(offset, msg1, msg2, msg3);   // R20.12
  1;
) : 0);

@sample
while (ev_i < ev_n && EV[ev_i * 3] <= smp ? (
  EV[ev_i * 3 + 2] > 0 ? pad_press(EV[ev_i * 3 + 1], EV[ev_i * 3 + 2]) : pad_release(EV[ev_i * 3 + 1]);
  ev_i += 1;
  1;
) : 0);
smp += 1;

out_l = out_r = 0;
state == S_READY ? (
  v = 0;
  loop(NV,
    st = V_ST[v];
    st != VS_OFF && st != VS_PARK ? (
      pos = V_POS[v];
      d = V_DIR[v];
      spd = step * V_SPD[v];
      looping = v < NPADS && CU_LOOP[v];                  // tails and the source never loop
      idx = max(0, min(floor(pos), frames - 1)); fr = pos - floor(pos);
      nxt = min(idx + 1, frames - 1);
      a = BUF[idx * nch]; l = a + (BUF[nxt * nch] - a) * fr;
      nch > 1 ? ( a = BUF[idx * nch + 1]; r = a + (BUF[nxt * nch + 1] - a) * fr; ) : r = l;  // R15.15

      V_FON[v] ? (
        a = V_B0[v] * l + V_B1[v] * V_X1L[v] + V_B2[v] * V_X2L[v] - V_A1[v] * V_Y1L[v] - V_A2[v] * V_Y2L[v];
        V_X2L[v] = V_X1L[v]; V_X1L[v] = l; V_Y2L[v] = V_Y1L[v]; V_Y1L[v] = a; l = a;
        nch > 1 ? (
          a = V_B0[v] * r + V_B1[v] * V_X1R[v] + V_B2[v] * V_X2R[v] - V_A1[v] * V_Y1R[v] - V_A2[v] * V_Y2R[v];
          V_X2R[v] = V_X1R[v]; V_X1R[v] = r; V_Y2R[v] = V_Y1R[v]; V_Y1R[v] = a; r = a;
        ) : r = l;
      );

      st == VS_ATT ? (
        V_ENV[v] += V_ATT[v];
        V_ENV[v] >= 1 ? (
          V_ENV[v] = 1;
          V_ST[v] = VS_SUS;
          // R15.9: in Trigger mode a set release starts once the attack is
          // done; a looping cue waits for its second press instead (R15.17)
          slider2 == 1 && V_RELSET[v] > 0 && !looping ? (
            V_REL[v] = 1 / max(V_RELSET[v] * srate, ramp_n);
            V_ST[v] = VS_REL;
          );
        );
      ) : st == VS_REL ? (
        V_ENV[v] -= V_REL[v];
      );

      // reach silence exactly at the cue's far end instead of cutting; a
      // slower release already running is sped up just enough
      rem = (d > 0 ? V_HI[v] - pos : pos - V_LO[v]) / spd;
      !looping && rem <= ramp_n ? (
        need = V_ENV[v] / max(rem, 1);
        V_ST[v] != VS_REL || V_REL[v] < need ? (
          V_REL[v] = need;
          V_ST[v] = VS_REL;
        );
      );

      V_XG[v] < 1 ? V_XG[v] = min(1, V_XG[v] + V_XGI[v]);
      g = max(V_ENV[v], 0) * V_GAIN[v] * V_XG[v];
      out_l += l * g; out_r += r * g;
      V_POS[v] = pos + d * spd;

      looping && V_ENV[v] > 0 && (d > 0 ? V_POS[v] >= V_HI[v] : V_POS[v] <= V_LO[v]) ? loop_seam(v)
      : V_ENV[v] <= 0 || V_POS[v] >= V_HI[v] || V_POS[v] < V_LO[v] ? (
        V_ENV[v] = 0;
        // R15.7: a held Hold-mode cue that reached its end waits silently
        V_ST[v] = v < NPADS && slider2 == 0 && V_HELD[v] && rem <= ramp_n + 1 ? VS_PARK : VS_OFF;
      );
    );
    v += 1;
  );

  // the playhead follows the source player, or else the last triggered cue
  src_playing ? (
    V_ST[SRC] == VS_OFF ? (
      src_playing = 0; lazy_pass = 0;                     // played to the end (R9.8)
      ph = frames - 1;
    ) : ph = V_POS[SRC];
  ) : ph_voice >= 0 ? (
    V_ST[ph_voice] == VS_OFF ? (
      // R15.6: Hold returns to the cue start; Trigger stays where it stopped (R15.10)
      ph = slider2 == 0 ? CU_START[ph_voice] * fsr : min(V_POS[ph_voice], frames - 1);
      ph_voice = -1;
    ) : ph = min(V_POS[ph_voice], frames - 1);
  );
);
spl0 = out_l;
spl1 = out_r;

@serialize
file_avail(0) >= 0 ? (
  // reading: project open, or an undo point being restored
  ser_ver = 0;
  file_var(0, ser_ver);
  ser_ver >= 1 && ser_ver <= 6 ? (
    file_string(0, #ser_path);
    file_var(0, ser_start);
    file_var(0, ser_len);
    file_var(0, ser_has);
    ser_ver >= 2 ? (
      i = 0;
      loop(NPADS,
        file_var(0, CU_SET[i]); file_var(0, CU_START[i]); file_var(0, CU_END[i]);
        file_var(0, CU_LEVEL[i]); file_var(0, CU_ATT[i]); file_var(0, CU_REL[i]);
        CU_FILT[i] = CU_REV[i] = CU_KEY[i] = CU_LOOP[i] = CU_XF[i] = 0;
        ser_ver >= 6 ? (
          file_var(0, CU_FILT[i]); file_var(0, CU_REV[i]); file_var(0, CU_KEY[i]);
          file_var(0, CU_LOOP[i]); file_var(0, CU_XF[i]);
        );
        i += 1;
      );
    );
    ser_ver >= 5 ? (                                      // R20.9
      file_var(0, M_CH);
      i = 0; loop(NPADS, file_var(0, M_PAD[i]); i += 1);
      i = 0;
      loop(NSTEPS,
        file_var(0, M_KIND[i]); file_var(0, M_NUM[i]); file_var(0, M_ENC[i]); file_var(0, M_CHN[i]);
        i += 1;
      );
      memset(REL_LAST, -1, NSTEPS);
      map_init = 1;
      // after a restart, a project's learned map is the default for new
      // instances too, even before the load action has run (R20.14)
      !gmem_has_map() ? map_to_gmem();
    ) : ser_ver >= 3 ? (
      // test builds with other step ids: read past, keep the current map
      file_var(0, ser_skip);
      loop(NPADS + 25 * (ser_ver == 4 ? 4 : 3), file_var(0, ser_skip));
    );
    ser_has ? (
      // undo restores run this too: only reload when the source really changed
      !has_source || strcmp(#ser_path, #path) != 0 || ser_start != sec_start || abs(ser_len - sec_len) > 0.000001 ? (
        strcpy(#req_path, #ser_path);
        req_start = ser_start;
        req_len = ser_len;
        reload_pending = 1;
      );
    ) : has_source ? eject();
  );
) : (
  ser_ver = 6;
  file_var(0, ser_ver);
  strcpy(#ser_path, #path);
  file_string(0, #ser_path);
  file_var(0, sec_start);
  file_var(0, sec_len);
  file_var(0, has_source);
  i = 0;
  loop(NPADS,
    file_var(0, CU_SET[i]); file_var(0, CU_START[i]); file_var(0, CU_END[i]);
    file_var(0, CU_LEVEL[i]); file_var(0, CU_ATT[i]); file_var(0, CU_REL[i]);
    file_var(0, CU_FILT[i]); file_var(0, CU_REV[i]); file_var(0, CU_KEY[i]);
    file_var(0, CU_LOOP[i]); file_var(0, CU_XF[i]);
    i += 1;
  );
  file_var(0, M_CH);
  i = 0; loop(NPADS, file_var(0, M_PAD[i]); i += 1);
  i = 0;
  loop(NSTEPS,
    file_var(0, M_KIND[i]); file_var(0, M_NUM[i]); file_var(0, M_ENC[i]); file_var(0, M_CHN[i]);
    i += 1;
  );
);

@gfx 900 760
function rgb(c) ( gfx_set(((c >> 16) & 255) / 255, ((c >> 8) & 255) / 255, (c & 255) / 255); );

function text_at(x, y, s) ( gfx_x = x; gfx_y = y; gfx_drawstr(s); );

function inside(x, y, w, hh) ( mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + hh; );

// file name without folders, for the header (R1.2)
function basename(src, dst) local(i, c, cut)
(
  cut = 0; i = 0;
  loop(strlen(src), c = str_getchar(src, i); c == 47 || c == 92 ? cut = i + 1; i += 1);
  strcpy_substr(dst, src, cut);
);

function fmt_time(t) ( t < 1 ? sprintf(#pv, "%d ms", floor(t * 1000 + 0.5)) : sprintf(#pv, "%.2f s", t); );

function param_label(k)
(
  k == 0 ? "Level" : k == 1 ? "Attack" : k == 2 ? "Release" : k == 3 ? "Filter"
  : k == 4 ? "Key" : k == 5 ? "Reverse" : k == 6 ? "Loop" : "Crossfade";
);

function param_text(k, p) local(f, fc)
(
  k == 0 ? sprintf(#pv, "%+.1f dB", CU_LEVEL[p])
  : k == 1 ? fmt_time(CU_ATT[p]) : k == 2 ? fmt_time(CU_REL[p])
  : k == 3 ? (
    f = CU_FILT[p]; fc = filter_fc(f);
    f == 0 ? strcpy(#pv, "off")
    : sprintf(#pv, fc < 1000 ? "%s %.0f Hz" : "%s %.1f kHz", f < 0 ? "LP" : "HP", fc < 1000 ? fc : fc / 1000);
  )
  : k == 4 ? sprintf(#pv, "%+d st", CU_KEY[p])
  : k == 5 ? strcpy(#pv, CU_REV[p] ? "on" : "off")
  : k == 6 ? strcpy(#pv, CU_LOOP[p] == 1 ? "forward" : CU_LOOP[p] == 2 ? "backward" : CU_LOOP[p] == 3 ? "alternate" : "off")
  : fmt_time(CU_XF[p]);
);

// Dragging up raises a value; px is already scaled down for fine steps.
// Times move on a square-root scale so short values stay easy to set.
function drag_param(k, p, px) local(u, len, n)
(
  k == 0 ? CU_LEVEL[p] += px * 0.1
  : k == 1 ? ( u = min(1, max(0, sqrt(CU_ATT[p] / 10) + px * 0.004)); CU_ATT[p] = 10 * u * u; )
  : k == 2 ? ( u = min(1, max(0, sqrt(CU_REL[p] / 10) + px * 0.004)); CU_REL[p] = 10 * u * u; )
  : k == 3 ? (
    CU_FILT[p] += px * 0.005;
    abs(CU_FILT[p]) < 0.003 ? CU_FILT[p] = 0;           // passing the centre lands on off
  )
  : k == 4 ? (
    // semitone steps (R17.8): collect pixels until a whole step is reached
    key_acc += px;
    n = key_acc > 0 ? floor(key_acc / 8) : -floor(-key_acc / 8);
    CU_KEY[p] += n; key_acc -= n * 8;
  )
  : k == 7 ? (
    len = cue_end(p) - CU_START[p];
    len > 0 ? ( u = min(1, max(0, CU_XF[p] / len + px * 0.004)); CU_XF[p] = len * u; );
  );
  clamp_params(p);
);

function button(x, y, w, hh, label, on) local(hot)
(
  hot = inside(x, y, w, hh);
  rgb(on ? C_BTN_ON : hot ? C_BTN_HOT : C_BTN); gfx_rect(x, y, w, hh);
  rgb(on ? C_TEXT : C_DIM);
  gfx_measurestr(label, tw, th);
  text_at(x + (w - tw) / 2, y + (hh - th) / 2, label);
  hot && clicked;
);

// Waveform of t0..t1 seconds into a box. Picks the coarsest peak table
// that still has at least one entry per pixel, raw samples when zoomed in.
function draw_wave(x, y, w, hh, t0, t1) local(f0, fpp, b1, b2, i, a, e, m, j, je, mid, half)
(
  f0 = t0 * fsr; fpp = (t1 - t0) * fsr / w;
  b1 = frames / NPEAKS; b2 = frames / NPEAKS2;
  mid = y + hh / 2; half = hh / 2 - 2;
  i = 0;
  loop(w,
    a = max(0, floor(f0 + i * fpp)); e = min(frames, max(a + 1, floor(f0 + (i + 1) * fpp)));
    m = 0;
    a < e ? (
      fpp >= b1 ? (
        j = floor(a / b1); je = min(NPEAKS, max(j + 1, ceil(e / b1)));
        loop(je - j, m = max(m, PEAKS[j]); j += 1);
      ) : fpp >= b2 ? (
        j = floor(a / b2); je = min(NPEAKS2, max(j + 1, ceil(e / b2)));
        loop(je - j, m = max(m, PEAKS2[j]); j += 1);
      ) : (
        j = a;
        loop(e - a, m = max(m, abs(BUF[j * nch])); nch > 1 ? m = max(m, abs(BUF[j * nch + 1])); j += 1);
      );
      gfx_line(x + i, mid - m * half, x + i, mid + m * half);
    );
    i += 1;
  );
);

function t2x(t) ( mw_x + (t - view_start) / view_len * mw_w; );
function x2t(x) ( view_start + (x - mw_x) / mw_w * view_len; );
function clamp_view() ( view_len = max(min_view, min(view_len, sec_len)); view_start = max(0, min(view_start, sec_len - view_len)); );

clicked = (mouse_cap & 1) && !(last_cap & 1);
released = !(mouse_cap & 1) && (last_cap & 1);
shift_held = mouse_cap & 8;

rgb(C_BG); gfx_rect(0, 0, gfx_w, gfx_h);
pad = 12;

// header: file name, length and format, eject
hdr_h = 52;
rgb(C_PANEL); gfx_rect(0, 0, gfx_w, hdr_h);
gfx_setfont(1, "Arial", 17);
has_source ? (
  basename(#path, #name);
  rgb(C_TEXT); text_at(pad, 8, #name);
  gfx_setfont(2, "Arial", 13);
  rgb(C_DIM);
  state == S_MISSING ? text_at(pad, 30, "source missing")
  : state == S_READY ? text_at(pad, 30, sprintf(#t, "%d:%06.3f  |  %g kHz  |  %s",
      floor(sec_len / 60), sec_len - floor(sec_len / 60) * 60, fsr / 1000, nch == 1 ? "mono" : "stereo"))
  : text_at(pad, 30, "loading ...");
  button(gfx_w - pad - 70, 13, 70, 26, "Eject", 0) ? eject();                // R3.1
) : (
  rgb(C_DIM); text_at(pad, 17, "No source loaded");
);
gfx_setfont(2, "Arial", 13);

ov_x = pad; ov_y = hdr_h + pad; ov_w = gfx_w - 2 * pad; ov_h = 60;
mw_x = pad; mw_y = ov_y + ov_h + 8; mw_w = gfx_w - 2 * pad; mw_h = 170;
rgb(C_PANEL); gfx_rect(ov_x, ov_y, ov_w, ov_h); gfx_rect(mw_x, mw_y, mw_w, mw_h);

state == S_READY ? (
  min_view = 256 / fsr;
  view_reset ? ( view_start = 0; view_len = sec_len; view_reset = 0; );
  clamp_view();
  step_len = view_len / 100;                              // Terms: step and minimum cue length

  // zoom with the mouse wheel over the main waveform, around the pointer (R7.5)
  mouse_wheel != 0 && inside(mw_x, mw_y, mw_w, mw_h) ? (
    zt = x2t(mouse_x);
    view_len *= mouse_wheel > 0 ? 0.8 : 1.25;
    clamp_view();
    view_start = zt - (mouse_x - mw_x) / mw_w * view_len;
    clamp_view();
  );
  mouse_wheel = 0;

  // keep the playhead in view while playing, unless frozen (R7.6, R7.7)
  moving = src_playing || ph_voice >= 0;
  pht = ph / fsr;
  moving && !freeze && drag_mode == 0 && (pht < view_start || pht > view_start + view_len) ? (
    view_start = pht - view_len * 0.1;
    clamp_view();
  );

  // overview: whole section, current view, cues and playhead (R7.1)
  rgb(C_WAVE_DIM);
  draw_wave(ov_x, ov_y, ov_w, ov_h, 0, sec_len);
  gfx_set(1, 1, 1, 0.08);
  gfx_rect(ov_x + view_start / sec_len * ov_w, ov_y, max(2, view_len / sec_len * ov_w), ov_h);
  gfx_a = 1;
  j = 0;
  loop(NPADS,
    CU_SET[j] ? ( rgb(PALETTE[j]); cx = ov_x + CU_START[j] / sec_len * ov_w; gfx_line(cx, ov_y, cx, ov_y + ov_h - 1); );
    j += 1;
  );
  gfx_set(1, 1, 1);
  cx = ov_x + pht / sec_len * ov_w; gfx_line(cx, ov_y, cx, ov_y + ov_h - 1);

  // main waveform with cue regions, handles and playhead (R7.2-R7.4, R7.8, R7.9)
  j = 0;
  loop(NPADS,
    CU_SET[j] && CU_END[j] >= 0 ? (
      x0 = max(mw_x, t2x(CU_START[j])); x1 = min(mw_x + mw_w, t2x(CU_END[j]));
      x1 > x0 ? ( rgb(PALETTE[j]); gfx_a = 0.18; gfx_rect(x0, mw_y, x1 - x0, mw_h); gfx_a = 1; );
    );
    j += 1;
  );
  rgb(C_WAVE);
  draw_wave(mw_x, mw_y, mw_w, mw_h, view_start, view_start + view_len);
  j = 0;
  loop(NPADS,
    CU_SET[j] ? (
      rgb(PALETTE[j]);
      cx = t2x(CU_START[j]);
      cx >= mw_x && cx < mw_x + mw_w ? (
        gfx_line(cx, mw_y, cx, mw_y + mw_h - 1);
        gfx_triangle(cx, mw_y, cx + 12, mw_y, cx, mw_y + 12);
        gfx_x = cx + 3; gfx_y = mw_y + 13; gfx_drawnumber(j + 1, 0);
      );
      // the end handle shows when an end is set; the selected cue also gets
      // a faint one at its implied end so an end can be dragged out (R10.15)
      CU_END[j] >= 0 || j == selected ? (
        cx = t2x(cue_end(j));
        gfx_a = CU_END[j] >= 0 ? 1 : 0.4;
        cx >= mw_x && cx <= mw_x + mw_w ? gfx_triangle(cx, mw_y + mw_h - 1, cx - 12, mw_y + mw_h - 1, cx, mw_y + mw_h - 13);
        gfx_a = 1;
      );
    );
    j += 1;
  );
  gfx_set(1, 1, 1);
  cx = t2x(pht);
  cx >= mw_x && cx < mw_x + mw_w ? ( gfx_line(cx, mw_y, cx, mw_y + mw_h - 1); gfx_line(cx + 1, mw_y, cx + 1, mw_y + mw_h - 1); );

  // mouse down: handle drag, scrub, or overview seek
  clicked && !learn_active && inside(mw_x, mw_y, mw_w, mw_h) ? (
    drag_mode = 3;                                        // scrub unless a handle is hit (R6.3)
    j = 0;
    loop(NPADS,
      CU_SET[j] ? (
        abs(mouse_x - t2x(CU_START[j])) <= 7 && mouse_y < mw_y + 26 ? ( drag_mode = 1; drag_cue = j; );
        (CU_END[j] >= 0 || j == selected) && abs(mouse_x - t2x(cue_end(j))) <= 7 && mouse_y > mw_y + mw_h - 16 ? ( drag_mode = 2; drag_cue = j; );
      );
      j += 1;
    );
    drag_mode != 3 ? selected = drag_cue;
  );
  clicked && !learn_active && inside(ov_x, ov_y, ov_w, ov_h) ? drag_mode = 4;

  (mouse_cap & 1) && drag_mode ? (
    drag_mode == 1 ? set_start(drag_cue, x2t(mouse_x))   // R10.1
    : drag_mode == 2 ? set_end(drag_cue, x2t(mouse_x))   // R10.2
    : drag_mode == 3 ? (
      seek_pos = max(0, min(sec_len, x2t(mouse_x))) * fsr; seek_req = 1;
    ) : drag_mode == 4 ? (
      seek_pos = max(0, min(1, (mouse_x - ov_x) / ov_w)) * sec_len * fsr; seek_req = 1;   // R6.4
    );
  );
) : state == S_LOADING || state == S_PEAKS ? (
  // R4.3
  bar_y = mw_y + mw_h / 2 - 4;
  rgb(C_FRAME); gfx_rect(mw_x + 40, bar_y, mw_w - 80, 8);
  rgb(C_WAVE); gfx_rect(mw_x + 40, bar_y, (mw_w - 80) * progress(), 8);
  rgb(C_DIM); text_at(mw_x + 40, bar_y - 22, "Loading ...");
) : state == S_MISSING ? (
  // R5.3, R5.5
  rgb(C_WARN); text_at(mw_x + 16, mw_y + 20, "The source file is missing:");
  rgb(C_TEXT); text_at(mw_x + 16, mw_y + 40, #path);
  rgb(C_DIM); text_at(mw_x + 16, mw_y + 72, "Select an item and run \"ReaFlip_Load.lua\" to use another file. Cues are kept.");
) : (
  // R3.3
  rgb(C_DIM);
  text_at(mw_x + 16, mw_y + 30, "Select an audio item (WAV or AIFF) in REAPER and run the action");
  text_at(mw_x + 16, mw_y + 50, "\"ReaFlip_Load.lua\" to load it here.");
);
released ? drag_mode = 0;

learn_active ? (
  rgb(C_PANEL); gfx_rect(mw_x, mw_y, mw_w, mw_h);
  rgb(C_WARN); gfx_rect(mw_x, mw_y, mw_w, mw_h, 0);
  lx = mw_x + 16; ly = mw_y + 12;
  button(mw_x + mw_w - 86, mw_y + 10, 76, 26, "Cancel", 0) ? learn_req = 3;
  learn_done ? (
    // summary of everything learned (R20.8)
    button(mw_x + mw_w - 170, mw_y + 10, 76, 26, "Confirm", 1) ? learn_req = 4;
    rgb(C_TEXT); text_at(lx, ly, sprintf(#t, "Learn done. Pads: notes %d..%d, channel %s.", LM_PAD[0], LM_PAD[15],
      LM_CH > 0 ? sprintf(#t2, "%d", LM_CH) : "any"));
    k = 1;
    loop(NSTEPS - 1,
      cx = lx + floor((k - 1) / 10) * 290; cy = ly + 20 + ((k - 1) % 10) * 13;
      rgb(LM_KIND[k] ? C_TEXT : C_DIM);
      text_at(cx, cy, sprintf(#t, "%s: %s", learn_name(k),
        LM_KIND[k] == K_NOTE ? sprintf(#t2, "note %d ch %d", LM_NUM[k], LM_CHN[k])
        : LM_KIND[k] == K_PB ? sprintf(#t2, "pitch bend ch %d", LM_CHN[k])
        : LM_KIND[k] == K_CC ? sprintf(#t2, "CC %d ch %d%s", LM_NUM[k], LM_CHN[k],
            LM_ENC[k] == E_CENTER ? " (64 +/- n)" : LM_ENC[k] == E_TWOS ? " (twos)"
            : LM_ENC[k] == E_SIGNBIT ? " (sign bit)" : LM_ENC[k] == E_ABS ? " (absolute)" : "")
        : LM_KIND[k] == K_SAME ? "same as without SHIFT" : "skipped"));
      k += 1;
    );
  ) : (
    learn_step > L_DIAL ? ( button(mw_x + mw_w - 170, mw_y + 10, 76, 26, "Skip", 0) ? learn_req = 2; );
    rgb(C_DIM); text_at(lx, ly, sprintf(#t, "Learn  -  step %d of %d", learn_step + 1, NSTEPS));
    gfx_setfont(1, "Arial", 17); rgb(C_TEXT);
    kk = step_kind(learn_step);
    kb = shift_base(learn_step);
    kk == 0 ? sprintf(#t, "Hit pad %d on the controller.", learn_count + 1)
    : kk == 1 ? (
      sprintf(#t, learn_phase == 0 ? "%s %s slowly clockwise (%d of 6)." : "%s %s slowly counter-clockwise (%d of 6).",
        kb >= 0 ? "Hold SHIFT and turn" : learn_phase == 0 ? "Turn" : "Now turn",
        learn_step == L_DIAL || learn_step == L_SDIAL ? "the dial" : learn_name(learn_step), learn_count);
    )
    : learn_step == L_DIALPRESS ? strcpy(#t, "Press the dial down.")
    : learn_step >= L_ENC1P && learn_step < L_ENC1P + 4 ? sprintf(#t, "Press encoder %d down (a touch is not enough).", learn_step - L_ENC1P + 1)
    : kk == 2 ? sprintf(#t, kb >= 0 ? "Hold SHIFT and press %s." : "Press %s.", learn_name(kb >= 0 ? kb : learn_step))
    : strcpy(#t, "Slide a finger along the touch strip.");
    text_at(lx, ly + 34, #t);
    gfx_setfont(2, "Arial", 13); rgb(C_DIM);
    text_at(lx, ly + 62, learn_step <= L_DIAL ? "Required."
      : kb >= 0 ? "If it sends the same as without SHIFT, that is fine. Skip it if there is no such combination."
      : "Skip it if your controller has no such control.");
    has_learn_err ? ( rgb(C_ERR); text_at(lx, ly + 90, #learn_err); );
  );
);

info_y = mw_y + mw_h + 6;
has_err ? ( rgb(C_ERR); text_at(pad, info_y, #err); ) : (
  rgb(C_DIM);
  text_at(pad, info_y, sprintf(#t, "Strip: %s", strip_mode == 0 ? "filter" : strip_mode == 1 ? "pad level" : "crossfade"));
  rgb(C_TEXT); text_at(pad + 110, info_y, #slab_msg);
);

// MIDI monitor
rgb(C_DIM);
mon_count ? (
  ms = mon_1 & 0xF0;
  strcpy(#mtype, ms == 0x90 ? (mon_3 > 0 ? "note on" : "note off") : ms == 0x80 ? "note off"
    : ms == 0xB0 ? "CC" : ms == 0xA0 ? "aftertouch" : ms == 0xD0 ? "channel pressure"
    : ms == 0xE0 ? "pitch bend" : ms == 0xC0 ? "program change" : "other");
  text_at(gfx_w - pad - 330, info_y,
    sprintf(#t, "Last MIDI: %s  ch %d  %d / %d   (#%d)", #mtype, (mon_1 & 15) + 1, mon_2, mon_3, mon_count));
) : text_at(gfx_w - pad - 330, info_y, "Last MIDI: nothing received yet");

// controls; mode changes go through slider_automate so REAPER records them
bar_y = info_y + 22; bw = 64; bh = 26; bx = pad;
button(bx, bar_y, bw, bh, src_playing ? "Pause" : "Play", src_playing) ? play_req = 1;      // R6.1, R6.2
bx += bw + 12;
button(bx, bar_y, bw, bh, "Hold", slider2 == 0) ? ( slider2 = 0; slider_automate(slider2); ); bx += bw;
button(bx, bar_y, bw, bh, "Trigger", slider2 == 1) ? ( slider2 = 1; slider_automate(slider2); ); bx += bw + 12;
button(bx, bar_y, bw, bh, "Mono", slider3 == 0) ? ( slider3 = 0; slider_automate(slider3); ); bx += bw;
button(bx, bar_y, bw, bh, "Poly", slider3 == 1) ? ( slider3 = 1; slider_automate(slider3); ); bx += bw + 12;
button(bx, bar_y, bw + 10, bh, "Velocity", slider4 == 1) ? ( slider4 = !slider4; slider_automate(slider4); ); bx += bw + 22;
button(bx, bar_y, bw + 16, bh, "Lazy chop", slider5 == 1) ? ( slider5 = !slider5; slider_automate(slider5); ); bx += bw + 28;
button(bx, bar_y, bw, bh, "Delete", 0) && selected >= 0 ? del_req = selected + 1;           // R11.1
bx += bw + 12;
button(bx, bar_y, bw, bh, "Learn", learn_active) && !learn_active ? learn_req = 1;            // R20.2
// right-aligned: Freeze, then a gap, then zoom out / in
bx = gfx_w - pad - 70;
button(bx, bar_y, 70, bh, "Freeze", freeze) ? freeze = !freeze;                               // R7.7
bx -= 12 + 2 * 34;
button(bx, bar_y, 34, bh, "-", 0) ? ( view_len *= 1.5; clamp_view(); );                     // R7.5
button(bx + 34, bar_y, 34, bh, "+", 0) ? ( view_len /= 1.5; clamp_view(); );

// 4x4 pads, pad 1 bottom-left like the hardware; lit while sounding (R15.2),
// outlined when selected (R15.3). Shift-click deletes (R11.2).
// Parameter row for the selected cue (R17), in its colour (R17.13): drag up
// or down to change, Cmd/Ctrl for fine steps (R17.10), Alt-click resets
// (R17.9); Reverse toggles and Loop steps through its modes on a click.
row_y = bar_y + bh + 10; row_h = 40; row_gap = 6;
pw = floor((gfx_w - 2 * pad - 7 * row_gap) / 8);
has_sel = selected >= 0 && CU_SET[selected] && state == S_READY;
k = 0;
loop(8,
  px0 = pad + k * (pw + row_gap);
  rgb(C_PANEL); gfx_rect(px0, row_y, pw, row_h);
  has_sel ? ( rgb(PALETTE[selected]); gfx_rect(px0, row_y, pw, 2); );
  rgb(C_DIM); text_at(px0 + 8, row_y + 6, param_label(k));
  has_sel ? ( rgb(C_TEXT); text_at(px0 + 8, row_y + 22, param_text(k, selected)); )
          : text_at(px0 + 8, row_y + 22, "-");
  clicked && has_sel && !learn_active && inside(px0, row_y, pw, row_h) ? (
    mouse_cap & 16 ? reset_param(k, selected)
    : k == 5 ? CU_REV[selected] = !CU_REV[selected]
    : k == 6 ? CU_LOOP[selected] = (CU_LOOP[selected] + 1) % 4
    : ( drag_mode = 5; drag_param_k = k; drag_y = mouse_y; key_acc = 0; );
  );
  k += 1;
);
drag_mode == 5 && (mouse_cap & 1) && has_sel ? (
  mouse_y != drag_y ? (
    drag_param(drag_param_k, selected, (drag_y - mouse_y) * (mouse_cap & 4 ? 0.1 : 1));
    drag_y = mouse_y;
  );
);
pads_y = row_y + row_h + 12;
gap = 8;
ps = floor(min((gfx_w - 2 * pad - 3 * gap) / 4, (gfx_h - pads_y - pad - 3 * gap) / 4));
ps = max(ps, 20);
gfx_setfont(1, "Arial", 17);
p = 0;
loop(NPADS,
  col = p % 4; row = 3 - floor(p / 4);
  px = pad + col * (ps + gap); py = pads_y + row * (ps + gap);
  sounding = V_ST[p] != VS_OFF && V_ST[p] != VS_PARK;
  learn_active && learn_step == L_PADS ? (
    rgb(p < learn_count ? C_BTN_ON : C_PAD_EMPTY);
  ) : CU_SET[p] ? (
    rgb(PALETTE[p]);
    gfx_a = sounding ? 1 : 0.35;
  ) : (
    rgb(C_PAD_EMPTY);                                     // R11.5
  );
  gfx_rect(px, py, ps, ps);
  gfx_a = 1;
  (learn_active && learn_step == L_PADS ? p == learn_count : p == selected) ? (
    rgb(learn_active ? C_WARN : C_TEXT); gfx_rect(px, py, ps, ps, 0); gfx_rect(px + 1, py + 1, ps - 2, ps - 2, 0);
  );
  learn_active && learn_step == L_PADS && p < learn_count ? (
    rgb(C_DIM); gfx_x = px + 8; gfx_y = py + ps - 20; gfx_drawstr(sprintf(#t, "note %d", LM_PAD[p]));
  );
  rgb(sounding ? C_BG : C_TEXT);
  gfx_x = px + 8; gfx_y = py + 6; gfx_drawnumber(p + 1, 0);
  clicked && !learn_active && inside(px, py, ps, ps) ? (
    shift_held ? del_req = p + 1 : ( gfx_press = p + 1; mouse_pad = p + 1; );
  );
  p += 1;
);
released && mouse_pad ? ( gfx_release = mouse_pad; mouse_pad = 0; );

last_cap = mouse_cap;
